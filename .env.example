# Supabase (donaties)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sanity CMS (headless CMS voor blogposts en fotoslider)
# Vraag deze gegevens op in je Sanity-project: https://www.sanity.io/manage

# Frontend (Vite)
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-02-23
VITE_SANITY_USE_CDN=true

# Google Analytics 4
VITE_GA_TRACKING_ID=G-EH610OXTXL

# Live statistieken (automatisch via Cloudflare Workers / Supabase)
VITE_TRAINING_START_DATE=2027-01-01

# Strava OAuth (server-side, Cloudflare Functions)
# Vul deze in in Cloudflare Pages environment variables, NIET in het publieke Vite-build
STRAVA_CLIENT_ID=85976
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=https://project1570.pages.dev/api/strava-callback
# SYNC_SECRET=your-random-sync-secret

# Legacy: wordt alleen gebruikt door de nog inactieve fetcher in src/lib/strava.ts
VITE_STRAVA_ACCESS_TOKEN=your-strava-token
VITE_INTERVALS_ICU_API_KEY=your-intervals-api-key
VITE_INTERVALS_ATHLETE_ID=your-intervals-athlete-id

# Sanity Studio (lokaal draaien)
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
