# Supabase (donaties)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sanity CMS (headless CMS voor blogposts en fotoslider)
# Vraag deze gegevens op in je Sanity-project: https://www.sanity.io/manage

# Frontend (Vite)
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-02-23
VITE_SANITY_USE_CDN=true

# Live statistieken (bewust nog NIET actief; alleen handmatige invoer via Sanity wordt nu gebruikt)
VITE_TRAINING_START_DATE=2029-01-01
VITE_STRAVA_ACCESS_TOKEN=your-strava-token
VITE_INTERVALS_ICU_API_KEY=your-intervals-api-key
VITE_INTERVALS_ATHLETE_ID=your-intervals-athlete-id

# Sanity Studio (lokaal draaien)
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
